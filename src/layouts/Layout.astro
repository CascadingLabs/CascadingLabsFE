---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
interface Props {
	title?: string;
	description?: string;
	frontmatter?: { title?: string; description?: string };
}

const title = Astro.props.title ?? Astro.props.frontmatter?.title ?? 'Cascading Labs';
const description = Astro.props.description ?? Astro.props.frontmatter?.description ?? 'Cascading Labs documentation and projects.';
const brand = Astro.url.pathname === '/yosoi' || Astro.url.pathname.startsWith('/yosoi/') ? 'yosoi' : 'cascading-labs';
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link id="site-favicon" rel="icon" type="image/x-icon" sizes="96x96" href="/favicon.ico" data-brand={brand} />
		<ThemeInit />
		<title>{title === 'Cascading Labs' || title.includes('|') ? title : `${title} | Cascading Labs`}</title>
	</head>
	<body class:list={{ 'home-page': isHome }}>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="site-shell">
			<main id="main">
				<header class="site-header">
					<slot name="heading"><a class="wordmark" href="/">Cascading Labs</a></slot>
					<ThemeToggle />
				</header>
				<slot />
			</main>
		</div>
	</body>
</html>
