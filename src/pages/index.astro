---
import Layout from '../layouts/Layout.astro';
import Envelope from '../icons/envelope.svg';
import BrandIcon from '../components/BrandIcon.astro';

const description =
    'We are building the future of automation and data systems, starting with web data and finance.';

const email = 'contact@cascadinglabs.com';
---

<Layout title="Cascading Labs" description={description}>
	<h1 slot="heading" class="home-title">Cascading Labs</h1>

	<div class="home-copy">
		<p class="home-lead">{description}</p>

		<p>
			We aren't fully sure what that means yet, but we have the following
			assumptions:
		</p>

		<ul class="assumptions">
			<li>Black-box systems are universally dumb.</li>
			<li>Knowledge is the impetus of action.</li>
			<li>Causality is complicated.</li>
			<li>Fact checkers are necessarily biased.</li>
			<li>Information is a virus, and it spreads.</li>
		</ul>
	</div>

	<footer class="home-footer">
		<nav class="project-list" aria-label="Projects">
			<a href="/yosoi/" class="project-card">
				<BrandIcon brand="yosoi" />
				<span>Yosoi</span>
				<svg class="project-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
			</a>
			<a href="https://qscrape.dev/" class="project-card">
				<BrandIcon brand="qscrape" />
				<span>QScrape</span>
				<svg class="project-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
			</a>
		</nav>

		<hr class="contact-divider" />

		<a class="email-link" href={`mailto:${email}`}>
			<Envelope width="16" height="16" fill="currentColor" aria-hidden="true" />
			<span>{email}</span>
		</a>
	</footer>
</Layout>
