---
const { head } = Astro.locals.starlightRoute;
---
{head.filter(item => !(item.tag === 'link' && item.attrs?.rel === 'icon')).map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<link id="site-favicon" rel="icon" type="image/x-icon" sizes="96x96" href="/favicon.ico" data-brand="yosoi" />
