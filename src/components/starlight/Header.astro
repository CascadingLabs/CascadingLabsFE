---
import ThemeToggle from '../ThemeToggle.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import DocsReleaseSelect from '../DocsReleaseSelect.astro';
---
<div class="starlight-docs-header">
 <a class="starlight-docs-brand" href="/yosoi/" aria-label="Yosoi documentation home">
  <img class="project-icon-dark" src="/favicon-yosoi-dark.svg" width="32" height="32" alt="" />
  <img class="project-icon-light" src="/favicon-yosoi-light.svg" width="32" height="32" alt="" />
  <span>Yosoi</span><span class="starlight-docs-brand-divider" aria-hidden="true">/</span><span class="starlight-docs-brand-section">Docs</span>
 </a>
 <div class="starlight-docs-search"><Search /></div>
 <div class="starlight-docs-actions">
  <DocsReleaseSelect />
  <div class="starlight-docs-social"><SocialIcons /></div>
  <ThemeToggle />
 </div>
</div>
<script>
 const header = document.querySelector<HTMLElement>('.starlight-docs-header');
 const content = document.querySelector<HTMLElement>('.main-pane .sl-container');
 if (header && content) {
  const alignSearch = () => {
   const documentBox = content.getBoundingClientRect();
   const headerBox = header.getBoundingClientRect();
   header.style.setProperty('--docs-search-center', `${documentBox.x + documentBox.width / 2 - headerBox.x}px`);
   header.style.setProperty('--docs-search-width', `${Math.min(352, documentBox.width)}px`);
  };
  const observer = new ResizeObserver(alignSearch);
  observer.observe(content);
  observer.observe(header);
  window.addEventListener('resize', alignSearch);
  alignSearch();
 }
</script>
