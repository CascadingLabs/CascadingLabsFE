---
import Tag from '../icons/tag.svg';
import { readReleaseRegistry } from '../lib/docs-release-data';
import { archiveHref, visibleReleases } from '../lib/docs-releases';
import { readSnapshot } from '../lib/yosoi-snapshot';
const registry = readReleaseRegistry();
const snapshot = readSnapshot();
const label = snapshot.source.preview || snapshot.source.version.includes('-rc.') ? 'Preview' : 'Latest';
const latestLabel = snapshot.mode === 'working-tree-preview' ? label : `${label} · ${snapshot.source.version}`;
---
<details class="docs-release-select">
 <summary aria-label="Documentation release" aria-expanded="false">
  <Tag width={13} height={13} aria-hidden="true" />
  <span data-docs-release-label>{latestLabel}</span>
  <span aria-hidden="true">⌄</span>
 </summary>
 <nav aria-label="Documentation releases">
  <a href="/yosoi/" data-docs-release="latest" aria-current="page">{latestLabel}</a>
  {visibleReleases(registry, snapshot.source.version).map((release) => <a href={archiveHref(release.version)} data-docs-release={release.version}>{release.tag}</a>)}
 </nav>
</details>
<script>
 import { archiveHref } from '../lib/docs-releases';
 const picker = document.querySelector<HTMLDetailsElement>('.docs-release-select');
 const summary = picker?.querySelector('summary');
 const links = [...(picker?.querySelectorAll<HTMLAnchorElement>('[data-docs-release]') || [])];
 const url = new URL(location.href);
 const archived = url.pathname === '/yosoi/archive/';
 const page = archived ? url.searchParams.get('page') || '' : url.pathname.replace(/^\/yosoi\/?/, '').replace(/\/$/, '');
 const current = archived ? url.searchParams.get('version') : 'latest';
 for (const link of links) {
  const selected = link.dataset.docsRelease === current;
  if (selected) {
   link.setAttribute('aria-current', 'page');
   const label = picker?.querySelector('[data-docs-release-label]');
   if (label) label.textContent = link.textContent;
  } else link.removeAttribute('aria-current');
  link.href = link.dataset.docsRelease === 'latest' ? `/yosoi/${archived || !page ? '' : page + '/'}` : archiveHref(link.dataset.docsRelease || '', page);
 }
 // Resolve a valid latest destination before the link is used, including opening in a new tab.
 if (archived) void (async () => {
  try {
   const response = await fetch('/yosoi/route-index.json', { cache: 'no-cache' });
   const routes: string[] = response.ok ? await response.json() : [];
   const latest = links.find((link) => link.dataset.docsRelease === 'latest');
   if (latest) latest.href = `/yosoi/${routes.includes(page) && page ? page + '/' : ''}`;
  } catch { /* The overview remains a usable fallback. */ }
 })();
 const close = (restoreFocus = false) => {
  if (picker) picker.open = false;
  summary?.setAttribute('aria-expanded', 'false');
  if (restoreFocus) summary?.focus();
 };
 picker?.addEventListener('toggle', () => summary?.setAttribute('aria-expanded', String(picker.open)));
 document.addEventListener('click', (event) => {
  if (event.target instanceof Node && !picker?.contains(event.target)) close();
 });
 picker?.addEventListener('focusout', (event) => {
  if (event.relatedTarget instanceof Node && !picker.contains(event.relatedTarget)) close();
 });
 picker?.addEventListener('keydown', (event) => {
  if (event.key === 'Escape') { event.preventDefault(); close(true); return; }
  if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
  event.preventDefault();
  picker.open = true;
  const index = links.findIndex((link) => link === document.activeElement);
  const next = event.key === 'Home' ? 0 : event.key === 'End' ? links.length - 1 : event.key === 'ArrowDown' ? (index + 1) % links.length : index < 0 ? links.length - 1 : (index - 1 + links.length) % links.length;
  links[next]?.focus();
 });
</script>
