{
	"name": "cl-fe",
	"type": "module",
	"version": "0.0.1",
	"license": "Apache-2.0",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "bun run sync-docs && astro dev",
		"sync-docs": "node scripts/sync-docs.mjs",
		"build": "bun run sync-docs && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"test": "vitest run",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"check": "biome check --write --no-errors-on-unmatched .",
		"seo": "start-server-and-test 'astro dev --port 4245' http://localhost:4245 'npx unlighthouse --site http://localhost:4245'",
		"lighthouse": "astro build && lhci autorun --config=lighthouserc.desktop.json && lhci autorun --config=lighthouserc.mobile.json"
	},
	"dependencies": {
		"@astrojs/compiler-rs": "^0.5.1",
		"@astrojs/markdown-remark": "^7.3.2",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/solid-js": "^7.0.2",
		"@astrojs/starlight": "^0.42.6",
		"@chenglou/pretext": "^0.0.9",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.8",
		"solid-js": "^1.9.17",
		"tailwindcss": "^4.3.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@lhci/cli": "^0.15.1",
		"start-server-and-test": "^3.0.13",
		"vitest": "^5.0.3"
	},
	"overrides": {
		"@puppeteer/browsers": "3.2.4",
		"js-yaml": "4.3.2",
		"uuid": "11.1.1",
		"tmp": "0.2.7",
		"basic-ftp": "6.2.1",
		"postcss-selector-parser": "7.1.6"
	}
}
