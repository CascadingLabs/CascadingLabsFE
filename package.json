{
	"name": "cascading-labs-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun scripts/docs/dev.mjs",
		"build": "bun scripts/docs/bundle.mjs",
		"preview": "astro preview",
		"sync": "astro sync",
		"lint": "vp lint --threads=1",
		"fmt": "vp fmt --threads=1",
		"fmt:check": "vp fmt --check --threads=1",
		"typecheck": "astro sync && tsc --noEmit",
		"check": "vp run fmt:check && vp run lint && vp run typecheck",
		"docs:dev": "bun scripts/docs/dev.mjs",
		"docs:prepare": "bun scripts/docs/prepare.mjs",
		"docs:published": "bun scripts/docs/bundle.mjs",
		"docs:reference": "bun scripts/docs/prepare.mjs --refresh-reference",
		"docs:build": "bun scripts/docs/build.mjs",
		"docs:export-release": "bun scripts/docs/export-release.mjs",
		"docs:register-release": "bun scripts/docs/register-release.mjs",
		"docs:test": "bun scripts/docs/test.mjs scripts/docs/navigation.test.mjs scripts/docs/prepare.test.mjs scripts/docs/reference.test.mjs scripts/docs/sidebar.test.ts scripts/docs/releases.test.ts scripts/docs/publication.test.mjs",
		"test": "bun scripts/docs/test.mjs scripts/docs/navigation.test.mjs scripts/docs/prepare.test.mjs scripts/docs/reference.test.mjs scripts/docs/sidebar.test.ts scripts/docs/releases.test.ts scripts/docs/publication.test.mjs scripts/docs/bundle.test.mjs",
		"docs:test:archive": "bun scripts/docs/test.mjs scripts/docs/archive-browser.test.mjs",
		"docs:test:preview": "bun scripts/docs/test.mjs scripts/docs/preview.test.mjs",
		"docs:test:site": "bun scripts/docs/test.mjs scripts/docs/site.test.mjs",
		"docs:test:live": "bun scripts/docs/test.mjs scripts/docs/live.test.mjs"
	},
	"dependencies": {
		"@astrojs/mdx": "8.0.3",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/starlight": "0.42.6",
		"@astrojs/starlight-tailwind": "5.0.0",
		"@fontsource/dm-mono": "^5.3.0",
		"astro": "7.3.8",
		"dompurify": "3.4.16",
		"marked": "18.1.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.4",
		"jsonc-parser": "^3.3.1",
		"mdast-util-gfm": "3.1.0",
		"mdast-util-to-markdown": "2.2.0",
		"playwright-core": "1.63.0",
		"postcss": "8.5.28",
		"postcss-nesting": "14.0.2",
		"satteri": "0.10.5",
		"tailwindcss": "4.3.3",
		"tar": "7.5.22",
		"typescript": "7.0.2",
		"vite-plus": "1.0.0"
	},
	"overrides": {
		"basic-ftp": "6.2.1",
		"js-yaml": "4.3.2",
		"postcss-selector-parser": "7.1.6",
		"tmp": "0.2.7",
		"uuid": "11.1.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
	},
	"packageManager": "bun@1.4.2"
}
